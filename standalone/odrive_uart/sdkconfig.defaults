CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BIKE_IMU_JY901P=y
CONFIG_BIKE_IMU_SDA_GPIO=21
CONFIG_BIKE_IMU_SCL_GPIO=22
CONFIG_BIKE_IMU_I2C_ADDRESS=0x50
CONFIG_BIKE_IMU_I2C_HZ=100000
CONFIG_BIKE_IMU_BANDWIDTH=2
